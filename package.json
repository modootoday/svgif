{
  "name": "@modootoday/svgif-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for svgif.js. The packages are under packages/ and apps/.",
  "files": [
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "type": "module",
  "packageManager": "bun@1.3.14",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.14.0"
  },
  "scripts": {
    "spec": "spec check",
    "typecheck": "tsc -p packages/svgif/tsconfig.json && tsc -p packages/svgif-export/tsconfig.json && tsc -p apps/studio/tsconfig.json && tsc -p packages/svgif-cli/tsconfig.json && tsc -p packages/svgif-mcp/tsconfig.json",
    "test": "bash scripts/ci/engine-gate.sh",
    "test:visual": "bash scripts/ci/visual-gate.sh",
    "test:export": "bash scripts/ci/export-gate.sh",
    "changelog:check": "bash scripts/changelog.sh --check"
  },
  "devDependencies": {
    "@modootoday/specfold": "0.8.1",
    "@types/node": "22.20.5",
    "playwright": "1.65.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modootoday/svgif.git"
  }
}
