{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thumly.io/schema/svgif/preset/v1.schema.json",
  "title": "svgif component preset",
  "description": "One component preset. component and motionPreset are the registry documents by $ref. parameters holds default values. motionPreset may be omitted. The registry has no maximum count. category is an open slug. later and out are not categories. adr:svgif/20261110181452.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "schemaRevision", "id", "category", "component", "parameters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "schemaRevision": { "const": 0 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Stable lowercase kebab slug, unique across the registry."
    },
    "category": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "not": { "enum": ["later", "out"] },
      "description": "Directory name under presets/. A v1 type id is an addressable category. The set is open. later and out are not categories."
    },
    "component": {
      "$ref": "https://thumly.io/schema/svgif/component/v1.schema.json"
    },
    "parameters": {
      "type": "array",
      "description": "Default parameter values. No maximum count. A non-reserved parameter may carry bind.",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "motionPreset": {
      "$ref": "https://thumly.io/schema/svgif/motion-preset/v1.schema.json"
    }
  },
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$"
        },
        "value": {
          "anyOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1 },
            { "type": "boolean" }
          ]
        },
        "bind": { "$ref": "#/$defs/bind" }
      },
      "allOf": [
        {
          "if": {
            "required": ["name"],
            "properties": {
              "name": { "enum": ["bpm", "loop", "scene", "sizeReason"] }
            }
          },
          "then": {
            "not": { "required": ["bind"] }
          }
        }
      ]
    },
    "bind": {
      "type": "object",
      "additionalProperties": false,
      "description": "One transform applied to the named layers. replace sets property to the parameter value. scale multiplies a numeric property by the value, or scales a path about origin. offset adds the value to a numeric property. A path offset moves along axis. swap writes the keys stored for that value. repeat sets the element count and steps copies along axis by the element size plus gap. retime multiplies key frames, or the timeline duration when property is duration. Optional at is the value that leaves the property unchanged. Scale and retime default at to 1. Offset defaults at to 0.",
      "required": ["kind", "layers"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["replace", "scale", "offset", "swap", "repeat", "retime"]
        },
        "layers": {
          "type": "array",
          "minItems": 1,
          "description": "Layer ids or timeline node ids. A name that matches neither is a broken bind.",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "property": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9.-]*$"
        },
        "at": {
          "type": "number",
          "description": "Parameter value that leaves the named property unchanged. Scale and retime default this to 1. Offset defaults this to 0."
        },
        "origin": {
          "description": "Scale origin for a path. A point [x, y], or center. Omitted and center use the center of the path bounding box at key 0.",
          "anyOf": [
            { "type": "string", "const": "center" },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          ]
        },
        "axis": {
          "description": "Direction for a path offset, or the repeat direction. x, y, or a unit vector [dx, dy]. Repeat accepts x or y and defaults to x. A path offset requires this.",
          "anyOf": [
            { "type": "string", "enum": ["x", "y"] },
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number" }
            }
          ]
        },
        "gap": {
          "type": "number",
          "description": "Extra space in px between repeated copies. Defaults to 0. Copies sit at the element width or height plus this gap."
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/variant" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["replace", "scale", "offset", "swap", "retime"] }
            }
          },
          "then": { "required": ["property"] }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "swap" } }
          },
          "then": { "required": ["variants"] }
        },
        {
          "if": {
            "required": ["kind", "property"],
            "properties": {
              "kind": { "const": "offset" },
              "property": { "enum": ["attr.d", "clip", "mask"] }
            }
          },
          "then": { "required": ["axis"] }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "repeat" } }
          },
          "then": {
            "properties": {
              "axis": { "type": "string", "enum": ["x", "y"] }
            }
          }
        }
      ]
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "value"],
      "properties": {
        "frame": { "type": "integer", "minimum": 0 },
        "value": {
          "anyOf": [
            { "type": "number" },
            { "type": "string" },
            { "type": "array", "items": { "type": "number" } }
          ]
        },
        "easing": {
          "type": "string",
          "pattern": "^(?:linear|hold|spring|cubic-bezier\\([^)]+\\))$"
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "keys"],
      "properties": {
        "value": {
          "anyOf": [
            { "type": "number" },
            { "type": "string", "minLength": 1 },
            { "type": "boolean" }
          ]
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "description": "Key list written onto the named property. Same fields as a motion-preset key.",
          "items": { "$ref": "#/$defs/key" }
        }
      }
    }
  }
}
