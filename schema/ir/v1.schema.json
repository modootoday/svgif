{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thumly.io/svgif/schema/ir/v1.schema.json",
  "title": "svgif composition timeline IR",
  "type": "object",
  "additionalProperties": false,
  "required": ["fps", "width", "height", "durationInFrames", "nodes"],
  "properties": {
    "fps": { "type": "integer", "minimum": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "durationInFrames": { "type": "integer", "minimum": 1 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tracks"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s-[A-Za-z0-9][A-Za-z0-9_-]*$",
          "description": "Stable selector id. The s- prefix is the one the backends emit."
        },
        "tracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/track" }
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "keys"],
      "properties": {
        "property": {
          "type": "string",
          "pattern": "^(?:transform\\.(?:translate[XY]|rotate|scale[XY]|matrix)|attr\\.(?:d|opacity|fill|stroke|offsetDistance)|filter\\.[A-Za-z][A-Za-z0-9-]*\\.[A-Za-z][A-Za-z0-9-]*|gradient\\.[A-Za-z][A-Za-z0-9-]*\\.(?:offset|stop-color)|clip|mask)$"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/key" }
        }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "value"],
      "properties": {
        "frame": { "type": "integer", "minimum": 0 },
        "value": {
          "anyOf": [
            { "type": "number" },
            { "type": "string" },
            {
              "type": "array",
              "items": { "type": "number" }
            }
          ]
        },
        "easing": {
          "type": "string",
          "pattern": "^(?:linear|hold|spring|cubic-bezier\\([^)]+\\))$"
        }
      }
    }
  }
}
