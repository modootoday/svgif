{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modootoday.github.io/svgif/schema/release-readiness/v1.schema.json",
  "title": "svgif release-readiness evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commit",
    "specCheck",
    "ciConclusion",
    "sensitiveGate",
    "milestone0",
    "e2eRunId",
    "e2eHeadSha",
    "retryCount",
    "results"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "specCheck": { "const": "passed" },
    "ciConclusion": { "const": "passed" },
    "sensitiveGate": { "const": "passed" },
    "milestone0": { "const": "passed" },
    "e2eRunId": { "type": "string", "minLength": 1 },
    "e2eHeadSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "retryCount": { "const": 0 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "browser", "status", "attempts", "evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "browser": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" },
          "attempts": { "const": 1 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
