{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thumly.io/svgif/schema/exporter-job/v1.schema.json",
  "title": "svgif exporter job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaRevision",
    "composition",
    "backend",
    "codec",
    "fps",
    "size"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "schemaRevision": { "const": 0 },
    "composition": {
      "$ref": "https://thumly.io/svgif/schema/ir/v1.schema.json"
    },
    "backend": { "enum": ["css-external", "css-embedded", "smil"] },
    "codec": { "enum": ["html", "svg", "webp", "webm", "mp4", "gif"] },
    "fps": { "type": "integer", "minimum": 1 },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
