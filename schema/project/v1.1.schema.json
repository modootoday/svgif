{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thumly.io/schema/svgif/project/v1.1.schema.json",
  "title": "svgif HTML project payload",
  "description": "Revision 1 of schemaVersion 1. Scene nodes may include the optional strings label and text. Compilers ignore both. The optional presentation object is the source of the card meta and the oEmbed files. The optional groups list keeps Studio layer groups; each group names two or more node ids, and compilers ignore it. Revision 0 is the v1 file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "schemaRevision",
    "generator",
    "runtime",
    "composition",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "schemaRevision": { "const": 1 },
    "generator": {
      "type": "string",
      "pattern": "^@modootoday/svgif@(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "version", "sri", "studioSri"],
      "properties": {
        "mode": { "enum": ["cdn", "inline"] },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        },
        "sri": {
          "type": "string",
          "pattern": "^sha(256|384|512)-[A-Za-z0-9+/]+={0,2}$"
        },
        "studioSri": {
          "type": "object",
          "additionalProperties": false,
          "description": "SRI for studio.js and studio.css at runtime.version.",
          "required": ["js", "css"],
          "properties": {
            "js": {
              "type": "string",
              "pattern": "^sha(256|384|512)-[A-Za-z0-9+/]+={0,2}$"
            },
            "css": {
              "type": "string",
              "pattern": "^sha(256|384|512)-[A-Za-z0-9+/]+={0,2}$"
            }
          }
        }
      }
    },
    "composition": {
      "$ref": "https://thumly.io/schema/svgif/ir/v1.1.schema.json"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generations"],
      "properties": {
        "generations": {
          "type": "array",
          "items": { "$ref": "#/$defs/generation" }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "presentation": { "$ref": "#/$defs/presentation" }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "childIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "childIds": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workId", "title", "description"],
      "properties": {
        "workId": { "type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "canonicalBase": { "type": "string", "pattern": "^https://[^/?#]+$" },
        "card": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "video": { "enum": ["none", "mp4", "webm"] }
          }
        },
        "posterFrame": { "type": "integer", "minimum": 0 },
        "authorName": { "type": "string", "minLength": 1 },
        "authorUrl": { "type": "string", "pattern": "^https://" },
        "twitterPlayer": { "type": "boolean" },
        "oembedType": { "enum": ["rich", "video"] }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parentId", "schemaVersion", "runtimeVersion", "savedAt"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "parentId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            { "type": "null" }
          ]
        },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "runtimeVersion": { "type": "string", "minLength": 1 },
        "savedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        }
      }
    }
  }
}
