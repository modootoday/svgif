{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git commit:*)",
      "Bash(git push -u origin claude/:*)",
      "Bash(git push origin claude/:*)",
      "Bash(npm ci:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run spec:*)",
      "Bash(bun test:*)",
      "Bash(node scripts/ci/:*)",
      "Bash(bash scripts/ci/:*)",
      "Bash(node scripts/e2e/:*)",
      "Bash(npx --no-install spec check:*)",
      "Bash(playpilot render:*)",
      "Bash(playpilot sync:*)",
      "Bash(playpilot mail:*)",
      "Bash(playpilot claim:*)",
      "Bash(playpilot release:*)",
      "Bash(playpilot history-check:*)",
      "Bash(playpilot surface-check:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr merge --auto:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)"
    ],
    "deny": [
      "Bash(gh secret:*)",
      "Bash(gh release:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh api repos/modootoday/svgif/rulesets:*)",
      "Bash(gh api -X POST repos/modootoday/svgif/rulesets:*)",
      "Bash(gh api -X PUT repos/modootoday/svgif/rulesets:*)",
      "Bash(gh api -X DELETE repos/modootoday/svgif/rulesets:*)",
      "Bash(npm publish:*)",
      "Bash(cargo publish:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push --tags:*)",
      "Bash(git push origin --tags:*)",
      "Bash(git push origin v:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin --force:*)",
      "Bash(git push origin -f:*)",
      "Bash(git add .)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.dev.vars)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.ssh/**)",
      "Read(~/.netrc)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/fleet/mailbox.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'R=fde47840d02fe81976d60d668f7fa08ee0211d24; B=\"$(command -v playpilot || echo \"$HOME/.cargo/bin/playpilot\")\"; D=\"$(dirname \"$(dirname \"$B\")\")\"; if [ \"$(cat \"$D/share/playpilot.rev\" 2>/dev/null)\" != \"$R\" ]; then for c in cargo /root/.cargo/bin/cargo \"$HOME/.cargo/bin/cargo\"; do command -v \"$c\" >/dev/null 2>&1 && \"$c\" install --force --locked --quiet --git https://github.com/modootoday/playpilot --rev \"$R\" --root \"$D\" playpilot >&2 && mkdir -p \"$D/share\" && echo \"$R\" > \"$D/share/playpilot.rev\" && break; done; fi; [ -x \"$B\" ] || { echo \"playpilot CLI is missing and could not be installed\" >&2; exit 2; }; PLAYPILOT_PROTECTED_BRANCHES=main exec \"$B\" guard'",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
